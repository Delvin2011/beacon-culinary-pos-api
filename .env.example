# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# spring-dotenv loads .env at startup; real environment variables take precedence.

# JWT signing secret: at least 32 random bytes (HS256).
JWT_SECRET=

# Application database (SQL Server).
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Test database. Its name must contain "test"; the tests delete data.
# Defaults to BeaconculinaryTest on localhost when unset.
TEST_DATASOURCE_URL=

# Allowed browser origins, comma-separated (default http://localhost:3000).
CORS_ALLOWED_ORIGINS=

# HTTP port (default 8080).
SERVER_PORT=

# Login protection: off | monitor (default) | enforce (blocks; 429s and the DEVICE_PIN limit).
LOGIN_PROTECTION_MODE=

# Optional variables below are commented out: a blank KEY= is an empty value, not the default.
# Uncomment only to set a value.

# WS1-1b POS till registration: off (default) | optional | required.
#SECURITY_DEVICETRUST_MODE=
# true to allow "add this browser to an existing till" (DEVICE_SERIAL_EXISTS / joinDeviceId). Default false.
#SECURITY_DEVICETRUST_MULTIBROWSERENABLED=
# Default true.
#SECURITY_DEVICETRUST_REQUIRESERIAL=

# T0-2 site locale. The zone must map to South Africa Standard Time (the report views assume it)
# or the app refuses to start. Defaults: Africa/Johannesburg, ZAR, R.
#SITE_TIME_ZONE=
#SITE_CURRENCY_CODE=
#SITE_CURRENCY_SYMBOL=

# T0-4a: fallback business name on statement reports, used only when the receipt settings have
# none. Blank by default; set the name in the receipt settings at onboarding instead.
#APP_BUSINESS_NAME=

# T0-6a: the address staff open the frontend at, for invite links. Blank: the API returns no link
# and the frontend builds it. Invite links last 72 hours unless set (1-720; also a site setting).
#APP_PUBLIC_BASE_URL=
#AUTH_INVITES_EXPIRYHOURS=
# T0-6a: true refuses sign-in by the seeded demo accounts outside production too (always on in prod).
#SECURITY_DEMOACCOUNTS_BLOCKSIGNIN=

# T0-7: true makes Flyway also read db/baseline (on in the prod profile): an empty database starts from the
# baseline without demo data. Needed wherever a database built from the baseline runs with Flyway on.
#APP_FLYWAY_INCLUDEBASELINE=

# T1-L0: the path a proxy removes in front of this API (e.g. /api for the local stack and Front Door), so the
# refresh cookie's path is the address the browser calls (/api/auth/refresh). Blank when called directly.
#COOKIE_PATHPREFIX=

# T1-L0: the SSE keepalive interval (default 25s; 0 turns it off). Behind Front Door it must stay well under its
# 4-minute idle timeout.
#APP_SSE_KEEPALIVEINTERVAL=

# T1-1: single (default) or multi. multi needs the platform database (its URL without credentials, a user and a
# password). Pool size default 3; directory cache default 30s.
#APP_TENANCY_MODE=
#APP_TENANCY_PLATFORM_URL=
#APP_TENANCY_PLATFORM_USERNAME=
#APP_TENANCY_PLATFORM_PASSWORD=
#APP_TENANCY_PLATFORM_POOLSIZE=
#APP_TENANCY_DIRECTORYCACHETTL=
# T1-1: secret values by name (SecretResolver; read from T1-2): SECRET_ + the name in upper case, - as _, e.g.
# SECRET_BEACONCULINARY_DB_PASSWORD for beaconculinary-db-password. Key Vault references in Azure (T1-0b).
# T1-2, multi mode only: each customer database's pool (defaults 5 connections, 5m idle, closed after 30m unused,
# 10s wait) and the SQL Server major version Hibernate assumes (default 12). docs/2026-11-24-routing-data-source.md
#APP_TENANCY_CUSTOMERPOOL_MAXIMUMSIZE=
#APP_TENANCY_CUSTOMERPOOL_IDLETIMEOUT=
#APP_TENANCY_CUSTOMERPOOL_EVICTAFTER=
#APP_TENANCY_CUSTOMERPOOL_CONNECTIONTIMEOUT=
#APP_TENANCY_DATABASEMAJORVERSION=

# T0-1 logging: paths with no request log line (default /health,/**/stream). Levels by
# LOGGING_LEVEL_<PACKAGE>, e.g. LOGGING_LEVEL_COM_BEACONCULINARY_API_DEVICES=DEBUG.
#LOGGING_REQUEST_SKIP_PATHS=

# O1: true makes POST /orders require clientOrderId (default false, until every till sends it).
#POS_REQUIRE_CLIENT_ORDER_ID=

# O2 tills and sessions. Defaults: 3 active tills, registration not required, lock after 5 idle
# minutes, expire after 30.
#POS_TILLS_MAXACTIVE=
#POS_TILLS_REQUIREREGISTERED=
#POS_SESSION_IDLELOCKMINUTES=
#POS_SESSION_IDLEEXPIRYMINUTES=

# O3/O4 offline selling (default off). The signing key is Base64, at least 32 bytes, required when
# enabled: a dedicated secret per environment, never JWT_SECRET. Other limits (hours, account cap)
# default as in application.yaml (pos.offline) and can be set with POS_OFFLINE_* the same way.
POS_OFFLINE_ENABLED=
POS_OFFLINE_GRANTSIGNINGKEY=
#POS_OFFLINE_GRANTKEYID=
# Optional previous key, verify-only, for rotating the signing key without refusing older grants.
#POS_OFFLINE_GRANTPREVIOUSSIGNINGKEY=
#POS_OFFLINE_GRANTPREVIOUSKEYID=

# Flyway Maven plugin (mvn flyway:info / flyway:migrate). Local or test databases only.
FLYWAY_URL=
FLYWAY_USER=
FLYWAY_PASSWORD=
