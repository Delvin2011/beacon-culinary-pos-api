# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# spring-dotenv loads .env at startup; real environment variables take precedence.

# JWT signing secret: at least 32 random bytes (HS256).
JWT_SECRET=

# Application database (SQL Server).
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Test database. Its name must contain "test"; the tests delete data.
# Defaults to BeaconculinaryTest on localhost when unset.
TEST_DATASOURCE_URL=

# Allowed browser origins, comma-separated (default http://localhost:3000).
CORS_ALLOWED_ORIGINS=

# HTTP port (default 8080).
SERVER_PORT=

# Login protection: off | monitor (default). "enforce" arrives in Phase 2.
LOGIN_PROTECTION_MODE=

# Flyway Maven plugin (mvn flyway:info / flyway:migrate). Local or test databases only.
FLYWAY_URL=
FLYWAY_USER=
FLYWAY_PASSWORD=
