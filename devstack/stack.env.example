# T1-L0 local stack settings. Copy to devstack/stack.env (git-ignored) and fill in. Names only here: never put a
# real value in this file. Defaults are in the comments; a line left blank takes its default.
# Production equivalent: Key Vault secrets and Container Apps settings (docs/2026-11-23-local-stack.md).

# --- Which customer the backend serves in single mode (TENANCY_MODE=single, below); multi mode serves them all ---
# beaconculinary (default) | testcustomer | any database made with new-customer.ps1
ACTIVE_CUSTOMER=

# --- SQL Server ---
# container (default): a SQL Server container with collation SQL_Latin1_General_CP1_CI_AS and a persistent volume.
# host: your own SQL Server (TCP/IP and SQL logins on); the databases are still created with that collation.
SQL_MODE=
# Container mode: the sa password (8+ characters, upper, lower, digit and symbol). Host mode: the login's password.
SQL_PASSWORD=
# Host mode only: the login (default sa) and the port your SQL Server listens on (default 1433).
SQL_USER=
SQL_HOST_INSTANCE_PORT=
# Container mode: the port on this machine (127.0.0.1 only) for the host's tools (default 14333).
SQL_HOST_PORT=

# --- Backend ---
# At least 32 random bytes. A local value only; never a value used anywhere else.
JWT_SECRET=
# off | monitor (default) | enforce
LOGIN_PROTECTION_MODE=

# --- Frontend ---
# container (default when the repository has a container file) | host (npm run dev on this machine, hot reload) | none
FRONTEND_MODE=
# The frontend repository (default: ../beacon-culinary-pos-front-end next to this repository).
FRONTEND_REPO=

# --- Gateway ---
# Ports on 127.0.0.1 (defaults 443 and 80). Another port changes every address to https://<customer>.pos.localhost:<port>.
HTTPS_PORT=
HTTP_PORT=

# --- Customer databases ---
# testcustomer's first admin (FirstAdminCommand prints their invite link on your console only).
FIRST_ADMIN_NAME=
FIRST_ADMIN_EMAIL=

# --- Smoke check (smoke.ps1) ---
# A beaconculinary account that signs in with a password (a demo account from the migrations is fine locally).
SMOKE_EMAIL=
SMOKE_PASSWORD=

# --- T1-1: the platform database and the customer database logins ---
# The platform database (default pos_platform) and its own login, pos_platform: its password. Every password below:
# 8+ characters, 3 of upper case, lower case, digits, symbols; no single quote ('). Used nowhere else.
PLATFORM_DB_PASSWORD=
PLATFORM_DATABASE=
# Each customer database has two logins of its own (T1-4). The app login (SECRET_<NAME>_DB_LOGIN, _DB_PASSWORD) is what
# the backend uses: read, write and execute only. The migration login (SECRET_<NAME>_DB_MIGRATION_LOGIN,
# _DB_MIGRATION_PASSWORD) is db_owner and used only by the customer migration command (up.ps1 runs it); the backend
# never gets it. The platform database stores the secrets' NAMES (<customer>-db-login, -db-password,
# -db-migration-login, -db-migration-password); these are their values (SECRET_<NAME>). Logins: names of their own,
# e.g. pos_beaconculinary and pos_beaconculinary_migrate (never sa). A customer made with new-customer.ps1 needs all
# four here too.
SECRET_BEACONCULINARY_DB_LOGIN=
SECRET_BEACONCULINARY_DB_PASSWORD=
SECRET_BEACONCULINARY_DB_MIGRATION_LOGIN=
SECRET_BEACONCULINARY_DB_MIGRATION_PASSWORD=
SECRET_TESTCUSTOMER_DB_LOGIN=
SECRET_TESTCUSTOMER_DB_PASSWORD=
SECRET_TESTCUSTOMER_DB_MIGRATION_LOGIN=
SECRET_TESTCUSTOMER_DB_MIGRATION_PASSWORD=
# T1-3: multi (default) | single. multi: every customer at its own address, https://<name>.pos.localhost. single: only
# ACTIVE_CUSTOMER (the others answer 503 at Caddy). up.ps1 -TenancyMode single does it for one run.
TENANCY_MODE=

# --- Compose project name (default beacon-devstack); a second name gives a second, separate set of volumes ---
STACK_NAME=
